# Copy to .env and edit. Every variable is optional; config.py documents them
# all and holds the defaults.

# Enables the written brief. Without a key the service returns the matches,
# the hosts, the ranking and the fix evidence, and says that the brief is
# missing. The key is read by the provider's SDK and is never logged, stored
# in a response or written to the index. Keep this file out of git (it is
# ignored) and readable only by you: chmod 600 .env
# OPENAI_API_KEY=

# "openai" (default, gpt-5.6-luna), "anthropic" (claude-opus-5, reads
# ANTHROPIC_API_KEY), or "none" to run without a language model.
# BLAST_LLM_PROVIDER=openai
# BLAST_LLM_MODEL=gpt-5.6-luna

# Where the scanner exports are read from and where the index is written.
# BLAST_DATA_DIR=data
# BLAST_ARTIFACT_PATH=artifacts/index.sqlite

# Retrieval stages. The evaluation toggles these to compare configurations.
# BLAST_ENABLE_KEYWORD=true
# BLAST_ENABLE_DENSE=true
# BLAST_ENABLE_RERANK=true

# BLAST_LOG_LEVEL=INFO
