# Copy to .env and edit. Every variable is optional; config.py documents them
# all and holds the defaults.

# Enables the written brief. Without it the service returns the matches, the
# hosts, the ranking and the fix evidence, and says that the brief is missing.
# ANTHROPIC_API_KEY=

# Set to "none" to run without a language model even when a key is present.
# BLAST_LLM_PROVIDER=anthropic
# BLAST_LLM_MODEL=claude-opus-5

# Where the scanner exports are read from and where the index is written.
# BLAST_DATA_DIR=data
# BLAST_ARTIFACT_PATH=artifacts/index.sqlite

# Retrieval stages. The evaluation toggles these to compare configurations.
# BLAST_ENABLE_KEYWORD=true
# BLAST_ENABLE_DENSE=true
# BLAST_ENABLE_RERANK=true

# BLAST_LOG_LEVEL=INFO
